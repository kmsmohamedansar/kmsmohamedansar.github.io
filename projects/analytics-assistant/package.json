{
  "name": "analytics-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "node --no-warnings --import tsx src/data/seed-cli.ts",
    "mcp": "node --no-warnings --import tsx src/tools/mcp-server.ts",
    "server": "node --no-warnings --import tsx src/server/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "eval": "node --no-warnings --import tsx eval/run.ts",
    "test": "NODE_OPTIONS=--no-warnings vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "framer-motion": "^14.1.0",
    "mermaid": "^12.1.0",
    "playwright": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
